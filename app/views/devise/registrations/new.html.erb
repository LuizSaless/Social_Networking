<div class="container-fluid d-flex align-items-center justify-content-center"
     style="min-height:100vh;
            background-image: url('<%= image_path('login_bg2.jpeg') %>');
            background-size: cover;
            background-position: center;">

  <div class="col-11 col-sm-9 col-md-7 col-lg-5 authentication-inner py-5">

    <div class="card">
      <div class="p-4 p-sm-5">

        <div class="d-flex justify-content-center align-items-center pb-2 mb-4">
          <%= image_tag('logo.png',
                style: 'max-height:120px;',
                class: "img-fluid") %>
        </div>

        <% if alert %>
          <div class="text-center">
            <p class="text-danger"><%= alert %></p>
          </div>
        <% end %>

        <%= form_for(resource,
              as: resource_name,
              url: registration_path(resource_name),
              html: { multipart: true, data: { turbo: false } }) do |f| %>

          <%= render 'layouts/form_errors', record: resource %>

          <div class="form-group">
            <%= f.label :name %>
            <%= f.text_field :name,
                  autocomplete: "name",
                  class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :phone %>
            <%= f.text_field :phone,
                  autocomplete: "phone",
                  class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :avatar %>
            <%= f.file_field :avatar,
                  class: "form-control-file" %>
          </div>

          <div class="form-group">
            <%= f.label :email %>
            <%= f.email_field :email,
                  autocomplete: "email",
                  class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :password %>
            <%= f.password_field :password,
                  autocomplete: "new-password",
                  class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.submit 'Cadastrar',
                  class: "btn btn-primary btn-block" %>
          </div>

        <% end %>

        <div class="text-center mt-4">
          <%= link_to "Login", new_user_session_path %>
        </div>

      </div>
    </div>

  </div>
</div>
